- file:
    name: vereacoes.yaml
    description: |
            Ficheiro com os grupos principais para o registo de vereações
            das câmaras municipais portuguesas
- include: structures.pt-groups.yaml
- group:
    name: acto
    description: >
      Actos genericos, servem para vereacoes etc. Compostos por items
    position: [id, tipo, dia, mes, ano, loc, obs]
    also:
    - ref
    - loc
    - obs
    - presente
    - presente-f
    - referido
    - referida
    - item
    - ls
    - atr
    - rel
    counter: 0
      e por pessoas '
    guaranteed:
    - id
    - dia
    - mes
    - ano
    idprefix: his
    prefix: non
    source: pt-acto
    suffix: non
- group:
